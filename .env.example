# DeepSeek credentials are intentionally not committed. Copy this file to .env locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Keep false for the competition demo unless the bank explicitly authorizes data export.
FRAUD_GRAPH_AGENT_EXTERNAL_ENABLED=false
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
